{
  "name": "reforged-ts-release",
  "private": true,
  "description": "The release scripts of the reforged-ts workspace: Node programs behind the root release:*, patch-watch:*, skills:*, diagrams:* and test:slow-report scripts, and the rename map module the workspace's scripts import (reforged-ts-release/rename-map). Never published.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    "./rename-map": {
      "types": "./build/rename-map.d.ts",
      "default": "./build/rename-map.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run --root .. --project release",
    "prepare": "pnpm run build",
    "release:check-changeset": "tsc -p tsconfig.json && node build/cli/check-changeset.js",
    "release:check-patches": "tsc -p tsconfig.json && node build/cli/check-patches.js",
    "release:gate": "tsc -p tsconfig.json && node build/cli/major-changeset-gate.js",
    "release:template-gate": "tsc -p tsconfig.json && node build/cli/template-gate.js",
    "release:matrix": "tsc -p tsconfig.json && node build/cli/matrix.js",
    "release:version": "tsc -p tsconfig.json && node build/cli/version.js",
    "release:dist-tag": "tsc -p tsconfig.json && node build/cli/dist-tag.js",
    "release:template-clone": "tsc -p tsconfig.json && node build/cli/template-clone.js",
    "release:publish-check": "tsc -p tsconfig.json && node build/cli/publish-check.js",
    "release:template-dispatch": "tsc -p tsconfig.json && node build/cli/template-dispatch.js",
    "release:docs-cut": "tsc -p tsconfig.json && node build/cli/docs-cut.js",
    "actionlint": "tsc -p tsconfig.json && node build/cli/actionlint.js",
    "patch-watch:plan": "tsc -p tsconfig.json && node build/cli/patch-watch.js",
    "data:check": "tsc -p tsconfig.json && node build/cli/data-check.js",
    "diagrams:generate": "tsc -p tsconfig.json && node build/cli/diagrams.js generate",
    "diagrams:check": "tsc -p tsconfig.json && node build/cli/diagrams.js check",
    "repo:settings": "tsc -p tsconfig.json && node build/cli/repo-settings.js",
    "board:setup": "tsc -p tsconfig.json && node build/cli/board-setup.js",
    "board:reconcile": "tsc -p tsconfig.json && node build/cli/board-reconcile.js",
    "board:labels": "tsc -p tsconfig.json && node build/cli/board-labels.js",
    "spec:check": "tsc -p tsconfig.json && node build/cli/spec-check.js",
    "github-app": "tsc -p tsconfig.json && node build/cli/github-app.js",
    "patch-watch:report": "tsc -p tsconfig.json && node build/cli/patch-watch-report.js",
    "skills:update": "tsc -p tsconfig.json && node build/cli/skills-update.js",
    "skills:copy": "tsc -p tsconfig.json && node build/cli/shared-copy.js",
    "test:slow-report": "tsc -p tsconfig.json && node build/cli/slow-tests.js"
  },
  "dependencies": {
    "@changesets/parse": "catalog:",
    "@manypkg/get-packages": "catalog:",
    "ajv": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
