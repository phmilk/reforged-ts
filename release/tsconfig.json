{
  // The release scripts, compiled like the Typings generator: Node programs
  // emitted to build/ and run by the root release:* scripts. The tests
  // (test/) have their own tsconfig.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "build",
    // Other workspace packages import the rename map module (package.json
    // `exports`), with its declarations.
    "declaration": true,
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "sourceMap": true,
    "newLine": "lf"
  },
  "include": ["src"]
}
