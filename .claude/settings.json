{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "reforged-ts": {
      "source": { "source": "github", "repo": "phmilk/reforged-ts" }
    }
  },
  "enabledPlugins": { "background-band@reforged-ts": true },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/shadowed-skills.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
