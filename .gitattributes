# Every text file is stored and checked out with LF, whatever core.autocrlf says.
* text=auto eol=lf

# Vendored Patch files stay byte for byte as downloaded, so their recorded sha256 holds on every platform.
packages/reforged-types/vendor/**/*.j -text
packages/reforged-types/vendor/**/*.ai -text
packages/reforged-types/test/fixtures/jass-history/**/*.j -text
packages/reforged-types/test/fixtures/jass-history/**/*.ai -text

# The Probe runner's map folder is a copy of the Template's editor-saved files
# (probe/PROVENANCE.md): git stores them byte for byte, as the Template does.
probe/probe.w3m/** -text -diff

# reforged-map's fixture map folders are copies of editor-saved files, and its
# wc3libs fixtures copies of wc3libs' files with their license: git stores them
# byte for byte (CRLF line ends included). The Map project fixtures are text.
packages/reforged-map/test/fixtures/*.w3m/** -text -diff
packages/reforged-map/test/fixtures/wc3libs/** -text -diff
