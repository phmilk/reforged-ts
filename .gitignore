# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
# ...except the stub packages of eslint-plugin-reforged's fixture project,
# which stand in for installed packages and are committed.
!packages/eslint-plugin-reforged/test/fixture-project/node_modules/
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and *not* Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# reforged-types generator build output (the generated Typings themselves are committed)
packages/reforged-types/build/

# reforged-test build output: the glue in dist/ (ignored above) and the runner's Lua
packages/reforged-test/lua/

# reforged-ts test build output: the library and its tests compiled to Lua
packages/reforged-ts/dist-test/

# The release scripts' build output
release/build/

# The docs site's build output and Docusaurus' generated files and cache
website/build/
website/.docusaurus/

# The docs tree's collected pages: docs:collect writes them from their sources
# (website/scripts/sources.mts) at every build, and a test checks that each
# output of a source is ignored here.
website/docs/contributing/guide.md
website/docs/contributing/glossary.md
website/docs/contributing/adr/
website/docs/contributing/agent-conventions.md
website/docs/contributing/adding-a-wrapper.md
website/docs/contributing/adding-a-lint-rule.md
website/docs/contributing/adding-a-patch.md
website/docs/changelog/*.md

# The API reference TypeDoc generates into the docs tree at every build
website/docs/api/reforged-ts/
website/docs/api/typings/*/

# Claude Code agent worktrees and local state
.claude/

# eslint-plugin-reforged cost measurement corpus (scripts/measure-cost.mjs removes it)
packages/eslint-plugin-reforged/test/fixture-project/.cost/
