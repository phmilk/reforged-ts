{
  // The workspace-level Node tests (the tarballs of the publishable
  // packages, and the repository's conventions under conventions/),
  // type-checked only; vitest runs them from source. The hooks of the shared
  // project settings too (../.claude/hooks/), dependency-free JavaScript with
  // JSDoc types, which their conventions test runs. skipLibCheck:
  // vitest's declarations pull in tinybench's, which name DOM types a Node
  // program does not have.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "newLine": "lf",
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["*.ts", "conventions/*.ts", "../.claude/hooks/*.mjs"]
}
