{
  "name": "reforged-ts-workspace",
  "private": true,
  "description": "Workspace root of reforged-ts: the library, its Typings and its Lua test harness.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:prettier": "prettier --check \"**/*.{json,md,yaml,yml}\"",
    "format": "eslint --fix . && prettier --write \"**/*.{json,md,yaml,yml}\"",
    "typecheck": "pnpm --recursive typecheck && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "typings:generate": "pnpm --filter reforged-types typings:generate",
    "typings:check": "pnpm --filter reforged-types typings:check",
    "coverage:report": "pnpm --filter reforged-ts-wrapper-coverage coverage:report",
    "data:check": "pnpm --filter reforged-ts build && pnpm --filter reforged-ts-release data:check",
    "changeset": "changeset",
    "release:check-changeset": "pnpm --filter reforged-ts-release release:check-changeset",
    "release:check-patches": "pnpm --filter reforged-ts-release release:check-patches",
    "release:gate": "pnpm --filter reforged-ts-release release:gate",
    "release:template-gate": "pnpm --filter reforged-ts-release release:template-gate",
    "release:matrix": "pnpm --filter reforged-ts-release release:matrix",
    "release:version": "pnpm --filter reforged-ts-release release:version",
    "release:dist-tag": "pnpm --filter reforged-ts-release release:dist-tag",
    "release:template-clone": "pnpm --filter reforged-ts-release release:template-clone",
    "release:publish-check": "pnpm --filter reforged-ts-release release:publish-check",
    "release:template-dispatch": "pnpm --filter reforged-ts-release release:template-dispatch",
    "docs:collect": "pnpm --filter reforged-ts-website docs:collect",
    "docs:start": "pnpm --filter reforged-ts-website docs:start",
    "docs:build": "pnpm --filter reforged-ts-website docs:build",
    "docs:check": "pnpm --filter reforged-ts-website docs:check",
    "docs:version": "pnpm --filter reforged-ts-website docs:version",
    "docs:prune": "pnpm --filter reforged-ts-website docs:prune",
    "actionlint": "pnpm --filter reforged-ts-release actionlint",
    "patch-watch:plan": "pnpm --filter reforged-ts-release patch-watch:plan",
    "patch-watch:report": "pnpm --filter reforged-ts-release patch-watch:report",
    "repo:settings": "pnpm --filter reforged-ts-release repo:settings",
    "github-app": "pnpm --filter reforged-ts-release github-app",
    "renovate:check": "pnpm --package=renovate@44.115.13 dlx renovate-config-validator --strict",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run typings:check && pnpm run test && pnpm run coverage:report"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
