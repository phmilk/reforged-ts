// The root scripts of package.json. `build` and `test` are the default build and
// test tasks; `check` is `pnpm check`, whose type and lint findings reach the
// Problems panel. vitest reports in its own panel, so `test` scans nothing.
//
// When pnpm runs a script in two or more packages that don't depend on each
// other, it prints each line behind a `<package path> <script>: ` prefix, the
// file relative to the package (#212). A run that selects one package prints
// no prefix: its type errors reach only `$tsc`, against the root. Each
// package that builds or type-checks has its own matcher: its regexp is
// `$tsc`'s behind that prefix, and its fileLocation is the package's folder.
// Each package whose build runs typescript-to-lua has a second one for
// tstl's own diagnostics, printed `error TSTL: ` (#291): no language server
// reports them, so they apply to open documents too, under their own owner.
// VS Code keeps the first matcher that matches a line, so they come before
// `$tsc`, which reads the root's unprefixed `tsc` errors.
// The `build` and `check` tasks hold the same list;
// test/conventions/editor.test.ts checks both against pnpm-workspace.yaml.
//
// A task runs in a terminal, where pnpm's TTY reporter prints a nested
// `pnpm --recursive` in a box: no prefix, each line behind `│ ` and cut to
// the terminal width, so no package matcher matches (#357). Every task sets
// `pnpm_config_reporter` to `append-only`, which every nested pnpm inherits:
// the lines keep their prefix and their full message.
{
  "version": "2.0.0",
  "options": { "env": { "pnpm_config_reporter": "append-only" } },
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "pnpm build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [
        {
          "owner": "typescript-to-lua",
          "source": "tstl",
          "applyTo": "allDocuments",
          "fileLocation": [
            "relative",
            "${workspaceFolder}/packages/reforged-test"
          ],
          "pattern": {
            "regexp": "^packages/reforged-test \\S+: ([^\\s].*)[\\(:](\\d+)[,:](\\d+)(?:\\):\\s+|\\s+-\\s+)(error|warning|info)\\s+(TSTL)\\s*:\\s*(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "code": 5,
            "message": 6
          }
        },
        {
          "owner": "typescript-to-lua",
          "source": "tstl",
          "applyTo": "allDocuments",
