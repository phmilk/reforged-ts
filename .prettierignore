# field table and its declarations their generator's test expects, the pnpm
# lockfile and the skills CLI's lock.
packages/reforged-types/overlay/
packages/reforged-types/[0-9]*/
packages/reforged-types/[0-9]*.d.ts
packages/reforged-types/vendor/
packages/reforged-types/scripts/war3-types-strict.json
packages/reforged-builtins/[0-9]*/
packages/reforged-builtins/[0-9]*.d.ts
packages/reforged-builtins/test/fixtures/fields/fields.json
packages/reforged-builtins/test/fixtures/fields/fields.d.ts
pnpm-lock.yaml
skills-lock.json

# The docs versions docs:version cuts: frozen copies of the docs tree, with the
# generated pages, and the files Docusaurus writes for them.
website/versions.json
website/versioned_docs/
website/versioned_sidebars/

# The compatibility matrix, written byte for byte by release:matrix.
release/compatibility/matrix.json
release/compatibility/matrix.md

# The Wrapper coverage report, written byte for byte by coverage:report.
wrapper-coverage/report.json
wrapper-coverage/report.md

# Lua is not formatted.
*.lua

# Agent worktrees and local state. The Upstream skills keep upstream's bytes
# (skills-lock.json); the repository's own Agent skills and the list of what
# both repositories share are formatted.
.claude/*
