{
  // The Probe runner's Node side, compiled like the release scripts: Node
  // programs emitted to build/ and run by the root probe:* scripts. The
  // in-game side (game/) and the Probes (probes/) compile with
  // typescript-to-lua through probes/tsconfig.json; the tests (test/) have
  // their own tsconfig.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "build",
    // The package's other scripts import the reader, with its declarations.
    "declaration": true,
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "newLine": "lf"
  },
  "include": ["src"]
}
