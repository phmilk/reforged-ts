{
  // The Probe runner's Node side, compiled like the release scripts: Node
  // programs emitted to build/ and run by the root probe:* scripts. The
  // in-game side (game/) and the Probes (probes/) compile with
  // typescript-to-lua through probes/tsconfig.json; the tests (test/) have
  // their own tsconfig. The Game Data Versions are reforged-builtins' JSON
  // module, read from its source (src/game-data.ts): outside rootDir, so not
  // copied, and at the same depth from build/ as from src/.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "build",
    "types": ["node"],
    "resolveJsonModule": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "newLine": "lf"
  },
  "include": ["src"]
}
