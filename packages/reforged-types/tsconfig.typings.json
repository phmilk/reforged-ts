{
  // The build's type-check of the generated Typings, as a Map project sees
  // them: the entry of each Game version (which references lua-types/5.3 and
  // the Lua runtime file) and its opt-in common.ai output. Declaration files
  // are the whole program, so skipLibCheck must stay off.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@typescript-to-lua/language-extensions"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true
  },
  "files": ["3.0.0.d.ts", "3.0.0/common.ai.d.ts"]
}
