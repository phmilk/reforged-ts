{
  // The Node glue: ESM compiled by tsc to dist/ with declarations, reached by
  // the package name. The runner (runner/) and the glue tests (test/) have
  // their own tsconfig. skipLibCheck: vitest's declarations pull in
  // tinybench's, which name DOM types a Node program does not have.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src"]
}
