// Generates the two files that list the Natives of `common.j`, from the
// Typings of their newest Patch (the `reforged.patch` of their package.json):
// runner/map/natives.ts, the names `stubNative` and `newHandle` of
// `reforged-test/map` are typed with (every Native and every Handle type),
// and stubs/unstubbed.lua, the Shipped stub that makes every Native no other
// Shipped stub covers throw a message naming `stubNative`. The Typings are a
// development dependency only: the names are written into the files, which
// ship as map/natives.d.ts and stubs/unstubbed.lua. Run it for a new Patch,
// as `pnpm --filter reforged-test natives:generate`; test/natives.test.ts is
// the Drift check, which fails when a committed file is not what this emits.
import { readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

/** The generated names `stubNative` and `newHandle` are typed with. */
export const NATIVES_FILE = fileURLToPath(
  new URL("../runner/map/natives.ts", import.meta.url),
);

/** The generated Shipped stub of the Natives without a Stub. */
export const UNSTUBBED_FILE = fileURLToPath(
  new URL("../stubs/unstubbed.lua", import.meta.url),
);

/** The Game version of a Patch: `3.0.1` of `3.0.1.24370`. */
function gameVersion(patch: string): string {
  return patch.split(".").slice(0, 3).join(".");
}

/** The Typings' Patch, the `reforged.patch` of their package.json. */
export function typingsPatch(): string {
  const manifest = JSON.parse(
    readFileSync(
      new URL("../../reforged-types/package.json", import.meta.url),
      "utf8",
    ),
  ) as { reforged: { patch: string } };
  return manifest.reforged.patch;
}

/** The declarations of `common.j` in the Typings of `patch`. */
export function commonDeclarations(patch: string): string {
  return readFileSync(
    new URL(
      `../../reforged-types/${gameVersion(patch)}/common.j.d.ts`,
      import.meta.url,
    ),
    "utf8",
  );
}

/** The first capture of every match of `pattern`, in the text's order. */
function names(text: string, pattern: RegExp): string[] {
  return [...text.matchAll(pattern)].flatMap((match) => match[1] ?? []);
}

/** The Natives `common.j` declares, in its order. */
function nativeNames(declarations: string): string[] {
  return names(declarations, /^declare function (\w+)\(/gm);
}

/**
 * The text of stubs/unstubbed.lua for the declarations of `common.j`.
 * @param patch - The Patch the declarations are of, named in the header.
 * @param declarations - The text of the Typings' `common.j.d.ts`.
 */
export function unstubbedSource(patch: string, declarations: string): string {
  const natives = nativeNames(declarations);
  if (natives.length === 0) {
    throw new Error(
      "natives: found 0 Natives in common.j.d.ts; its declarations changed form",
    );
  }
  return [
    `-- Generated by scripts/natives.mts from common.j of Patch ${patch} in the`,
    "-- Typings. Do not edit: run `pnpm --filter reforged-test natives:generate`.",
    "--",
    "-- The Natives without a Stub: every Native of common.j that no stub file",
    "-- defined before this one becomes a function that throws a message naming",
    "-- the Native and stubNative, where Lua would say `attempt to call a nil",
    "-- value`. The glue executes this file last of the shipped stub files, so",
    "-- it keeps every Shipped stub, and before the extra stub files of the",
    "-- `stubs` option, which define over it. The functions of blizzard.j and",
    "-- common.ai are not Natives and stay undefined, and _G gets no metatable.",
    "",
    "local natives = {",
    ...natives.map((name) => `  "${name}",`),
    "}",
    "",
    "-- The function this file gave each Native without a Stub, by its name.",
    "local unstubbed = {}",
    "",
    "for i = 1, #natives do",
    "  local name = natives[i]",
    "  if rawget(_G, name) == nil then",
    "    -- Level 2: the error names the line that called the Native.",
    "    local function native()",
    "      error(",
    "        name",
    '          .. " is a Native reforged-test does not stub: give it an answer with stubNative(\\""',
    "          .. name",
    '          .. "\\", …)",',
    "        2",
    "      )",
    "    end",
    "    unstubbed[name] = native",
    "    _G[name] = native",
    "  end",
    "end",
    "",
    "-- Whether the global `name` is a Native without a Stub: the function this",
    "-- file defined, which nothing replaced since. Not a Native, so it adds no",
    "-- call-log line.",
    "function __stub_unstubbed(name)",
    "  local native = unstubbed[name]",
    "  return native ~= nil and rawget(_G, name) == native",
    "end",
    "",
  ].join("\n");
}

/**
 * The text of runner/map/natives.ts for the declarations of `common.j`,
 * formatted as Prettier formats it.
 * @param patch - The Patch the declarations are of, named in the header.
 * @param declarations - The text of the Typings' `common.j.d.ts`.
 */
export function nativesSource(patch: string, declarations: string): string {
  const natives = nativeNames(declarations);
  const handles = names(declarations, /^declare interface (\w+) /gm);
  if (natives.length === 0 || handles.length === 0) {
    throw new Error(
      `natives: found ${String(natives.length)} Natives and ${String(handles.length)} Handle types in common.j.d.ts; its declarations changed form`,
    );
  }
  return [
    "/** @noSelfInFile */",
    "",
    `// Generated by scripts/natives.mts from common.j of Patch ${patch} in the`,
    "// Typings. Do not edit: run `pnpm --filter reforged-test natives:generate`.",
    "",
    "/**",
    " * The name of a Native of `common.j`, as `stubNative` takes it: the",
    " * functions of `blizzard.j` and `common.ai` are not Natives and are left out.",
    " * @example A unit's name, answered in the test",
    " * {@includeCode ../../examples/stub-native.test.ts}",
    " */",
    "export type NativeName =",
    ...natives.map(
      (name, index) =>
        `  | "${name}"${index === natives.length - 1 ? ";" : ""}`,
    ),
    "",
    "/**",
    " * The Handle types of `common.j` by name, as `newHandle` takes one: the kind",
    ' * `"unit"` gives a `unit`.',
    " * @example A Native that creates a Handle",
    " * {@includeCode ../../examples/new-handle.test.ts}",
    " */",
    "export interface HandleTypes {",
    ...handles.flatMap((name) => [
      `  /** The Handle type \`${name}\`. */`,
      `  ${name}: ${name};`,
    ]),
    "}",
    "",
  ].join("\n");
}

const script = process.argv.at(1);
if (
  script !== undefined &&
  pathToFileURL(resolve(script)).href === import.meta.url
) {
  const patch = typingsPatch();
  const declarations = commonDeclarations(patch);
  writeFileSync(NATIVES_FILE, nativesSource(patch, declarations));
  writeFileSync(UNSTUBBED_FILE, unstubbedSource(patch, declarations));
  process.stdout.write(`natives: wrote ${NATIVES_FILE}\n`);
  process.stdout.write(`natives: wrote ${UNSTUBBED_FILE}\n`);
}
