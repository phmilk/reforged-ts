{
  // The package's Node scripts (the generator of runner/map/natives.ts),
  // which Node runs from source with --experimental-strip-types: type-checked
  // only, nothing is emitted. erasableSyntaxOnly holds them to what type
  // stripping can run.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "newLine": "lf"
  },
  "include": ["."]
}
