{
  "name": "reforged-builtins",
  "version": "1.0.0-alpha.7",
  "description": "The Built-in objects of each Warcraft III Reforged Patch, reduced to derived identifiers: Rawcode, Object kind, race, enUS name and Game data sets.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "warcraft",
    "wc3",
    "reforged",
    "typescript-to-lua",
    "rawcode"
  ],
  "homepage": "https://phmilk.github.io/reforged-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phmilk/reforged-ts.git",
    "directory": "packages/reforged-builtins"
  },
  "bugs": {
    "url": "https://github.com/phmilk/reforged-ts/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "reforged": {
    "patch": "3.0.1.24370"
  },
  "exports": {
    "./3.0.0": {
      "types": "./3.0.0.d.ts"
    },
    "./3.0.0/index.json": "./3.0.0/index.json",
    "./3.0.0/fields.json": "./3.0.0/fields.json",
    "./3.0.1": {
      "types": "./3.0.1.d.ts"
    },
    "./3.0.1/index.json": "./3.0.1/index.json",
    "./3.0.1/fields.json": "./3.0.1/fields.json",
    "./units": {
      "types": "./3.0.1/units.d.ts",
      "tstl": "./3.0.1/units"
    },
    "./items": {
      "types": "./3.0.1/items.d.ts",
      "tstl": "./3.0.1/items"
    },
    "./abilities": {
      "types": "./3.0.1/abilities.d.ts",
      "tstl": "./3.0.1/abilities"
    },
    "./buffs": {
      "types": "./3.0.1/buffs.d.ts",
      "tstl": "./3.0.1/buffs"
    },
    "./destructables": {
      "types": "./3.0.1/destructables.d.ts",
      "tstl": "./3.0.1/destructables"
    },
    "./doodads": {
      "types": "./3.0.1/doodads.d.ts",
      "tstl": "./3.0.1/doodads"
    },
    "./upgrades": {
      "types": "./3.0.1/upgrades.d.ts",
      "tstl": "./3.0.1/upgrades"
    },
    "./fields": {
      "types": "./3.0.1/fields.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/[0-9]*.d.ts",
    "/[0-9]*/*.d.ts",
    "/[0-9]*/*.lua",
    "/[0-9]*/index.json",
    "/[0-9]*/fields.json",
    "/LICENSE",
    "/README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run --root ../.. --project reforged-builtins",
    "builtins:generate": "tsc -p tsconfig.json && node build/cli/generate.js",
    "builtins:check": "tsc -p tsconfig.json && node build/cli/check.js",
    "builtins:measure": "tsc -p tsconfig.json && node build/cli/measure.js"
  },
  "peerDependencies": {
    "reforged-types": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-to-lua/language-extensions": "catalog:",
    "reforged-studio": "workspace:^",
    "reforged-test": "workspace:^",
    "reforged-ts": "workspace:^",
    "reforged-types": "workspace:^",
    "typescript": "catalog:",
    "typescript-to-lua": "catalog:",
    "vitest": "catalog:"
  }
}
