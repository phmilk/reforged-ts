{
  // The generator: ESM compiled by tsc to build/, run by builtins:generate on
  // the maintainer's machine and never published (the package ships its
  // output alone). The tests (test/) have their own tsconfig.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "build",
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "newLine": "lf"
  },
  "include": ["src"]
}
