{
  // The Map project fixtures as the editor and the lint see them: sources of
  // a Map project that consumes the package, not of this package. The tests
  // (../../map-project.test.ts) copy each fixture folder into a temporary Map
  // project whose node_modules holds the packed package and the workspace's
  // reforged-types, reforged-ts and reforged-test; this file is not copied.
  // Here the package's overloads are listed by path and its entry point and
  // `reforged-ts` mapped to the sources, since neither is installed in this
  // package. The negative fixtures' type errors are what the tests assert, so
  // this program is never built.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["reforged-types/3.0.0", "@typescript-to-lua/language-extensions"],
    "strict": true,
    "noEmit": true,
    "paths": {
      "reforged-builtins/units": ["../../../3.0.0/units.d.ts"],
      "reforged-ts": ["../../../../reforged-ts/src/index.ts"]
    }
  },
  "files": ["../../../3.0.0.d.ts"],
  "include": ["."]
}
