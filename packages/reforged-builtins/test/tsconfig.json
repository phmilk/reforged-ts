{
  // The tests: type-checked only; vitest runs them from source. The root is
  // the workspace's: probe-parity.test.ts imports the Probe runner's helpers.
  // The Map project fixtures are another program, with a tsconfig of their own.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../..",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["."],
  "exclude": ["fixtures"]
}
