{
  "name": "reforged-map",
  "version": "1.0.0-alpha.2",
  "description": "Reads a Warcraft III Reforged map folder and writes, for a reforged-ts Map project, the declarations and the Lua stub of its Editor globals and the FourCC overloads and constants of its objects, with a Rawcode lookup for tools.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "warcraft",
    "wc3",
    "reforged",
    "typescript-to-lua",
    "world-editor",
    "war3map"
  ],
  "homepage": "https://phmilk.github.io/reforged-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phmilk/reforged-ts.git",
    "directory": "packages/reforged-map"
  },
  "bugs": {
    "url": "https://github.com/phmilk/reforged-ts/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "reforged": {
    "patch": "3.0.0.24268"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "/dist/**/*.js",
    "/dist/**/*.cjs",
    "/dist/**/*.d.ts",
    "/dist/**/*.d.cts",
    "/typescript-plugin/package.json",
    "/LICENSE",
    "/README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run --root ../.. --project reforged-map",
    "prepare": "pnpm run build",
    "map:measure": "tsc -p tsconfig.measure.json && node build/test/measure/cli.js"
  },
  "peerDependencies": {
    "reforged-builtins": "workspace:^",
    "reforged-types": "workspace:^"
  },
  "peerDependenciesMeta": {
    "reforged-builtins": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-to-lua/language-extensions": "catalog:",
    "reforged-builtins": "workspace:^",
    "reforged-test": "workspace:^",
    "reforged-ts": "workspace:^",
    "reforged-types": "workspace:^",
    "typescript": "catalog:",
    "typescript-to-lua": "catalog:",
    "vitest": "catalog:"
  }
}
