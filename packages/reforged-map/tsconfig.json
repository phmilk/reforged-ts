{
  // ESM compiled by tsc to dist/ with declarations, as reforged-test's glue:
  // Node only, run at build time by a Map project, never compiled to Lua.
  // The tests (test/) have their own tsconfig.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src"]
}
