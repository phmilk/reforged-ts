{
  // ESM compiled by tsc to dist/ with declarations: Node only, run by the
  // Studio's server and by the reforged-builtins generator, which imports
  // the readers from it. The JSON modules are copied to dist/ with it. The
  // tests (test/) have their own tsconfig.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src"]
}
