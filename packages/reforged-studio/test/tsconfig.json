{
  // The tests: type-checked only; vitest runs them from source. The DOM's
  // types are for the callbacks the page's tests (page.test.ts) run in the
  // browser through Playwright's `evaluate`.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["."]
}
