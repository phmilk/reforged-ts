{
  "name": "reforged-studio",
  "version": "1.0.0-alpha.7",
  "description": "The Studio of reforged-ts: a local app that edits a Map project's Object data, and the reader of the developer's own Warcraft III install it reads the game from.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "warcraft",
    "wc3",
    "reforged",
    "typescript-to-lua",
    "casc",
    "object-editor"
  ],
  "homepage": "https://phmilk.github.io/reforged-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phmilk/reforged-ts.git",
    "directory": "packages/reforged-studio"
  },
  "bugs": {
    "url": "https://github.com/phmilk/reforged-ts/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "reforged": {
    "patch": "3.0.1.24370"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "reforged-studio": "./dist/cli/studio.js"
  },
  "files": [
    "/dist/**/*.js",
    "/dist/**/*.d.ts",
    "/dist/game-data-versions.json",
    "/dist/page/**",
    "/LICENSE",
    "/NOTICES.md",
    "/README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build page --outDir ../dist/page --emptyOutDir --base / --logLevel warn",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json && tsc -p page/tsconfig.json",
    "test": "vitest run --root ../.. --project reforged-studio",
    "studio:check-install": "tsc -p tsconfig.json && node dist/cli/check-install.js",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "reforged-map": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "mdx-m3-viewer-th": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reforged-map": "workspace:^",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
