{
  // The plugin: ESM compiled by tsc to dist/ with declarations, loaded by
  // ESLint in Node. The tests (test/) have their own tsconfig; the fixture
  // project under test/ is a Map project, another program again.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src"]
}
