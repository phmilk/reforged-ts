{
  // The CLI: ESM compiled by tsc to dist/, run by Node alone. It has no
  // runtime dependency, so its packed tarball runs with plain `node`. The
  // tests (test/) have their own tsconfig.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src"]
}
