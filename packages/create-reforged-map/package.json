{
  "name": "create-reforged-map",
  "version": "1.0.0-alpha.2",
  "description": "Creates a reforged-ts Map project from the Template in one command: the Template's files, its dependencies installed, its maintenance files removed and a first commit.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "warcraft",
    "wc3",
    "reforged",
    "typescript-to-lua",
    "create",
    "scaffold"
  ],
  "homepage": "https://phmilk.github.io/reforged-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phmilk/reforged-ts.git",
    "directory": "packages/create-reforged-map"
  },
  "bugs": {
    "url": "https://github.com/phmilk/reforged-ts/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "reforged": {
    "patch": "3.0.1.24370"
  },
  "bin": {
    "create-reforged-map": "./dist/cli.js"
  },
  "files": [
    "/dist/**/*.js",
    "/LICENSE",
    "/README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run --root ../.. --project create-reforged-map",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
