{
  // The site's Node scripts (docs:collect), which Node runs from source with
  // --experimental-strip-types: type-checked only, nothing is emitted.
  // erasableSyntaxOnly holds them to what type stripping can run. They are
  // .mts files: the website package cannot be "type": "module" (Docusaurus'
  // generated client files would be bundled as ES modules and break), so the
  // extension makes them ES modules.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "newLine": "lf"
  },
  "include": ["."]
}
